import test from 'node:test';
import assert from 'node:assert/strict';
import {POST} from '../app/api/export/route.ts';
const request=(fields:Record<string,string>)=>{const data=new FormData();for(const [key,value]of Object.entries(fields))data.set(key,value);return new Request('http://localhost/api/export',{method:'POST',body:data});};
test('HTTP download preserves Unicode JSON and a safe Unicode filename',async()=>{const text=JSON.stringify({title:'中文歌曲',lyrics:'街灯 & <light>\n另一句'});const result=await POST(request({name:'中文 歌曲.json',mime:'application/json',encoding:'utf-8',content:text}));assert.equal(result.status,200);assert.equal(await result.text(),text);assert.match(result.headers.get('content-disposition')!,/attachment/);assert.match(result.headers.get('content-disposition')!,/filename\*=UTF-8''%E4%B8%AD/);assert.equal(result.headers.get('cache-control'),'no-store');});
test('PNG download preserves decoded binary bytes',async()=>{const bytes=Buffer.from('89504e470d0a1a0a00010203','hex');const result=await POST(request({name:'排行.png',mime:'image/png',encoding:'base64',content:bytes.toString('base64')}));assert.equal(result.status,200);assert.deepEqual(Buffer.from(await result.arrayBuffer()),bytes);assert.equal(result.headers.get('content-type'),'image/png');});
test('download refuses header injection, unknown types and invalid PNG payloads',async()=>{const normal={name:'x.json',mime:'application/json',encoding:'utf-8',content:'{}'};for(const fields of [{...normal,name:'x\r\nInjected.json'},{...normal,mime:'application/javascript'},{...normal,name:'x.png',mime:'image/png',encoding:'base64',content:'bm90IGEgcG5n'},{...normal,name:'../../x.json'}])assert.equal((await POST(request(fields))).status,400);});
